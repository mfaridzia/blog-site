---
import type { MarkdownHeading } from 'astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-container max-h-[calc(100vh-10rem)] overflow-y-auto space-y-3 text-xs" aria-label="Table of contents">
    <p class="font-mono font-bold uppercase tracking-widest text-[var(--green)] text-[11px]">
      {t('post.toc')}
    </p>

    <ol class="space-y-2">
      {filteredHeadings.map((heading) => (
        <li class:list={['toc-item', heading.depth === 3 ? 'pl-3' : '']}>
          <a
            href={`#${heading.slug}`}
            class="toc-link block py-0.5 text-[var(--ink-soft)] hover:text-[var(--green)] transition-colors line-clamp-1 leading-normal"
            data-slug={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  function setupTocScrollspy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (!links.length) return;

    const headingElements = Array.from(links)
      .map((link) => {
        const slug = link.dataset.slug;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (!headingElements.length) return;

    function updateActive() {
      const scrollY = window.scrollY;
      let activeIndex = 0;

      for (let i = 0; i < headingElements.length; i++) {
        const heading = headingElements[i];
        if (heading.offsetTop - 140 <= scrollY) {
          activeIndex = i;
        } else {
          break;
        }
      }

      links.forEach((link, idx) => {
        if (idx === activeIndex) {
          link.classList.add('text-[var(--green)]', 'font-semibold');
          link.classList.remove('text-[var(--ink-soft)]');
        } else {
          link.classList.remove('text-[var(--green)]', 'font-semibold');
          link.classList.add('text-[var(--ink-soft)]');
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }

  setupTocScrollspy();
  document.addEventListener('astro:after-swap', setupTocScrollspy);
</script>
