---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  totalPosts: number;
}

const { lang, totalPosts } = Astro.props;
const t = useTranslations(lang);
---

<div class="space-y-4 sm:space-y-6 pt-8 sm:pt-10 border-t border-[var(--line)]">
  <div class="flex flex-wrap items-end justify-between gap-2 sm:gap-4">
    <h2 id="archive" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--ink)] tracking-tight scroll-mt-24">
      {t('archive.title')}
    </h2>
    <span id="posts-count-label" class="font-mono text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">
      {totalPosts} {t('archive.postsCount')}
    </span>
  </div>

  <!-- Topic Pills with smooth horizontal scrolling on mobile -->
  <div
    class="flex items-center gap-1.5 sm:gap-2 pb-1 overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none"
    role="radiogroup"
    aria-label={t('filter.label')}
  >
    {siteConfig.topics.map((topic, index) => (
      <button
        type="button"
        data-topic={topic.id}
        class:list={[
          'topic-btn whitespace-nowrap px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs font-medium transition-all cursor-pointer border shrink-0',
          index === 0
            ? 'active-topic bg-[var(--green)] text-white border-[var(--green)] shadow-xs font-semibold'
            : 'bg-[var(--card)] text-[var(--muted)] border-[var(--line)] hover:text-[var(--ink)] hover:border-[var(--green)]'
        ]}
      >
        {topic.label[lang]}
      </button>
    ))}
  </div>
</div>

<script>
  function setupTopicFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.topic-btn');
    const posts = document.querySelectorAll<HTMLElement>('.post-item');
    const countLabel = document.getElementById('posts-count-label');
    if (!buttons.length || !posts.length) return;

    function applyFilter(selectedTopic: string) {
      let visibleCount = 0;

      buttons.forEach((btn) => {
        const isSelected = btn.dataset.topic === selectedTopic;
        if (isSelected) {
          btn.className = 'topic-btn active-topic whitespace-nowrap px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs font-semibold transition-all bg-[var(--green)] text-white border border-[var(--green)] shadow-xs cursor-pointer shrink-0';
        } else {
          btn.className = 'topic-btn whitespace-nowrap px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs font-medium transition-all bg-[var(--card)] text-[var(--muted)] border border-[var(--line)] hover:text-[var(--ink)] hover:border-[var(--green)] cursor-pointer shrink-0';
        }
      });

      posts.forEach((post) => {
        const topics = (post.dataset.topics || '').split(',').map((t) => t.trim().toLowerCase());
        if (selectedTopic === 'all' || topics.includes(selectedTopic.toLowerCase())) {
          post.style.display = '';
          visibleCount++;
        } else {
          post.style.display = 'none';
        }
      });

      if (countLabel) {
        const unit = countLabel.textContent?.includes('artikel') ? 'artikel' : 'posts';
        countLabel.textContent = `${visibleCount} ${unit}`;
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const topic = btn.dataset.topic || 'all';
        applyFilter(topic);

        const url = new URL(window.location.href);
        if (topic === 'all') {
          url.searchParams.delete('topic');
        } else {
          url.searchParams.set('topic', topic);
        }
        window.history.replaceState({}, '', url.toString());
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const initialTopic = urlParams.get('topic');
    if (initialTopic) {
      applyFilter(initialTopic.toLowerCase());
    }
  }

  setupTopicFilter();
  document.addEventListener('astro:after-swap', setupTopicFilter);
</script>
