---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  featuredPost?: CollectionEntry<'blog'>;
}

const { lang, featuredPost } = Astro.props;
const eyebrow = siteConfig.eyebrow[lang];
const title = siteConfig.title[lang];
const lede = siteConfig.lede[lang];
---

<section class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(300px,380px)] items-end gap-10 md:gap-14 pb-16">
  <!-- Left Intro Column -->
  <div class="space-y-4">
    <p class="text-xs font-bold uppercase tracking-widest text-[var(--moss)]">
      {eyebrow}
    </p>

    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium text-[var(--ink)] leading-[0.95] tracking-tight">
      {title}
    </h1>

    <p class="text-lg sm:text-xl text-[var(--ink-soft)] leading-relaxed max-w-2xl pt-2">
      {lede}
    </p>

    <!-- Social Links matching sdust.dev underline style -->
    <nav class="flex flex-wrap items-center gap-5 pt-3 text-sm font-semibold" aria-label="Social Profiles">
      {siteConfig.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noreferrer"
          class="text-[var(--moss)] hover:text-[var(--copper)] border-b border-[var(--copper)]/50 hover:border-[var(--copper)] pb-0.5 transition-colors"
        >
          {social.name}
        </a>
      ))}
    </nav>
  </div>

  <!-- Right Featured Post Column (Moss Banner) -->
  {featuredPost && (
    <div class="h-full flex items-end">
      <a
        href={formatUrl(`/posts/${featuredPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '')}`, lang)}
        class="group block w-full p-6 sm:p-8 rounded-xl bg-[var(--moss-surface)] text-[var(--on-moss)] hover:brightness-105 shadow-sm transition-all"
      >
        <span class="block text-[11px] font-semibold uppercase tracking-wider text-[var(--on-moss)]/75 mb-3">
          {formatDate(featuredPost.data.pubDate, lang)}
        </span>

        <h2 class="font-display text-2xl sm:text-3xl font-medium leading-snug mb-3 text-[var(--on-moss)] group-hover:underline underline-offset-4 decoration-[var(--copper)]">
          {featuredPost.data.title}
        </h2>

        <p class="text-sm leading-relaxed text-[var(--on-moss)]/85 line-clamp-3">
          {featuredPost.data.description}
        </p>
      </a>
    </div>
  )}
</section>
