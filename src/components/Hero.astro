---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  featuredPost?: CollectionEntry<'blog'>;
}

const { lang, featuredPost } = Astro.props;
const eyebrow = siteConfig.eyebrow[lang];
const title = siteConfig.title[lang];
const lede = siteConfig.lede[lang];
---

<section class="grid grid-cols-1 md:grid-cols-[minmax(0,1.2fr)_minmax(280px,380px)] items-end gap-8 md:gap-14 pt-2 sm:pt-4 pb-10 sm:pb-16 overflow-hidden">
  <!-- Left Intro Column -->
  <div class="space-y-3 sm:space-y-4 min-w-0">
    <p class="font-mono text-[11px] sm:text-xs font-semibold uppercase tracking-widest text-[var(--green)]">
      {eyebrow}
    </p>

    <h1 class="font-display text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-[var(--ink)] leading-[1.05] tracking-tight break-words">
      {title}
    </h1>

    <p class="text-base sm:text-lg md:text-xl text-[var(--muted)] leading-relaxed max-w-2xl pt-1 sm:pt-2 break-words">
      {lede}
    </p>

    <!-- Social Links -->
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 sm:pt-3 text-xs sm:text-sm font-semibold" aria-label="Social Profiles">
      {siteConfig.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noreferrer"
          class="text-[var(--green)] hover:text-[var(--ink)] border-b border-[var(--green)]/40 hover:border-[var(--green)] pb-0.5 transition-colors font-medium"
        >
          {social.name}
        </a>
      ))}
    </nav>
  </div>

  <!-- Right Featured Post Column -->
  {featuredPost && (
    <div class="h-full flex items-end min-w-0">
      <a
        href={formatUrl(`/posts/${featuredPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '')}`, lang)}
        class="group block w-full p-5 sm:p-7 md:p-8 rounded-xl bg-[var(--green)] text-white hover:brightness-105 shadow-md transition-all relative overflow-hidden"
      >
        <span class="block font-mono text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-[var(--lime)] mb-2.5">
          ✦ {formatDate(featuredPost.data.pubDate, lang)}
        </span>

        <h2 class="font-display text-xl sm:text-2xl md:text-3xl font-bold leading-snug mb-2.5 text-white group-hover:underline underline-offset-4 decoration-[var(--lime)] break-words">
          {featuredPost.data.title}
        </h2>

        <p class="text-xs sm:text-sm leading-relaxed text-[#d1e1d5] line-clamp-3 break-words">
          {featuredPost.data.description}
        </p>

        <div class="mt-3.5 sm:mt-4 flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--lime)]">
          <span>{lang === 'id' ? 'Baca selengkapnya' : 'Read article'}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    </div>
  )}
</section>
