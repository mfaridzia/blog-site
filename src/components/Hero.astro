---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  featuredPost?: CollectionEntry<'blog'>;
}

const { lang, featuredPost } = Astro.props;
const eyebrow = siteConfig.eyebrow[lang];
const title = siteConfig.title[lang];
const lede = siteConfig.lede[lang];
---

<section class="pt-8 pb-12 border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="space-y-4">
    <!-- Eyebrow -->
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      {eyebrow}
    </p>

    <!-- Main Title -->
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      {title}
    </h1>

    <!-- Lede Bio -->
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
      {lede}
    </p>

    <!-- Social Links -->
    <nav class="flex flex-wrap items-center gap-4 pt-2 text-sm font-medium text-slate-600 dark:text-slate-400" aria-label="Social Profiles">
      {siteConfig.socials.map((social) => {
        let iconName = 'mail';
        if (social.name === 'GitHub') iconName = 'github';
        if (social.name === 'LinkedIn') iconName = 'linkedin';
        if (social.name.includes('Twitter') || social.name.includes('X')) iconName = 'x';

        return (
          <a
            href={social.url}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-slate-900 dark:hover:text-white transition-colors"
          >
            <Icon name={iconName} class="w-4 h-4" />
            <span>{social.name}</span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Featured Post Banner (if available) -->
  {featuredPost && (
    <div class="mt-8">
      <a
        href={formatUrl(`/posts/${featuredPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '')}`, lang)}
        class="group block p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 shadow-xs hover:shadow-md transition-all relative overflow-hidden"
      >
        <div class="flex items-center justify-between gap-2 mb-2">
          <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-900/40">
            Featured
          </span>
          <time class="text-xs text-slate-400 dark:text-slate-500">
            {formatDate(featuredPost.data.pubDate, lang)}
          </time>
        </div>

        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          {featuredPost.data.title}
        </h2>

        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">
          {featuredPost.data.description}
        </p>

        <div class="mt-4 flex items-center text-xs font-semibold text-slate-900 dark:text-white group-hover:translate-x-1 transition-transform">
          <span>{lang === 'id' ? 'Baca artikel selengkapnya' : 'Read full article'}</span>
          <span class="ml-1">
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </span>
        </div>
      </a>
    </div>
  )}
</section>
