---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  featuredPost?: CollectionEntry<'blog'>;
}

const { lang, featuredPost } = Astro.props;
const eyebrow = siteConfig.eyebrow[lang];
const title = siteConfig.title[lang];
const lede = siteConfig.lede[lang];
---

<section class="grid grid-cols-1 md:grid-cols-[minmax(0,1.2fr)_minmax(300px,380px)] items-end gap-10 md:gap-14 pb-16">
  <!-- Left Intro Column -->
  <div class="space-y-4">
    <p class="font-mono text-xs font-semibold uppercase tracking-widest text-[var(--green)]">
      {eyebrow}
    </p>

    <h1 class="font-display text-5xl sm:text-6xl md:text-7xl font-bold text-[var(--ink)] leading-[0.96] tracking-tight">
      {title}
    </h1>

    <p class="text-lg sm:text-xl text-[var(--muted)] leading-relaxed max-w-2xl pt-2">
      {lede}
    </p>

    <!-- Social Links matching labs.muhfaridzia.live -->
    <nav class="flex flex-wrap items-center gap-5 pt-3 text-sm font-semibold" aria-label="Social Profiles">
      {siteConfig.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noreferrer"
          class="text-[var(--green)] hover:text-[var(--ink)] border-b border-[var(--green)]/40 hover:border-[var(--green)] pb-0.5 transition-colors font-medium"
        >
          {social.name}
        </a>
      ))}
    </nav>
  </div>

  <!-- Right Featured Post Column (Signature Forest Green Banner matching labs result card) -->
  {featuredPost && (
    <div class="h-full flex items-end">
      <a
        href={formatUrl(`/posts/${featuredPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '')}`, lang)}
        class="group block w-full p-6 sm:p-8 rounded-lg bg-[var(--green)] text-white hover:brightness-105 shadow-md transition-all relative overflow-hidden"
      >
        <span class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-[var(--lime)] mb-3">
          ✦ {formatDate(featuredPost.data.pubDate, lang)}
        </span>

        <h2 class="font-display text-2xl sm:text-3xl font-bold leading-tight mb-3 text-white group-hover:underline underline-offset-4 decoration-[var(--lime)]">
          {featuredPost.data.title}
        </h2>

        <p class="text-sm leading-relaxed text-[#d1e1d5] line-clamp-3">
          {featuredPost.data.description}
        </p>

        <div class="mt-4 flex items-center gap-1.5 font-mono text-xs font-semibold text-[var(--lime)]">
          <span>{lang === 'id' ? 'Baca selengkapnya' : 'Read article'}</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    </div>
  )}
</section>
