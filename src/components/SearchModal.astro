---
import type { Lang } from '../i18n/utils';
import { useTranslations, formatUrl } from '../i18n/utils';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getCollection('blog', ({ data }) => {
  return !data.draft && data.lang === lang;
});

const searchIndex = posts.map((post) => {
  const slug = post.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '');
  return {
    title: post.data.title,
    description: post.data.description,
    topics: post.data.topics,
    url: formatUrl(`/posts/${slug}`, lang),
    slug
  };
});
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-xs flex items-start justify-center pt-20 px-4 transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-label={t('search.placeholder')}
>
  <div
    class="w-full max-w-xl bg-[var(--card)] text-[var(--ink)] rounded-lg border border-[var(--line)] shadow-2xl overflow-hidden"
    id="search-modal-container"
  >
    <!-- Search Input Header -->
    <div class="flex items-center px-4 border-b border-[var(--line)]">
      <span class="text-[var(--muted)] shrink-0 mr-3">
        <Icon name="search" class="w-5 h-5" />
      </span>
      <input
        type="text"
        id="search-input"
        class="w-full py-4 text-base bg-transparent text-[var(--ink)] placeholder-[var(--muted)] focus:outline-hidden"
        placeholder={t('search.placeholder')}
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="button"
        id="search-close-btn"
        class="p-1.5 rounded-full text-[var(--muted)] hover:text-[var(--green)] cursor-pointer"
        aria-label={t('search.close')}
      >
        <Icon name="close" class="w-4 h-4" />
      </button>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" class="max-h-80 overflow-y-auto p-2 divide-y divide-[var(--line)]/50">
      <!-- Dynamically populated -->
    </div>

    <!-- Modal Footer Helper -->
    <div class="px-4 py-2.5 bg-[var(--paper-deep)] border-t border-[var(--line)] flex items-center justify-between font-mono text-[11px] text-[var(--muted)]">
      <div class="flex items-center gap-2">
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 bg-[var(--card)] rounded-sm border border-[var(--line)]">↑</kbd><kbd class="px-1.5 py-0.5 bg-[var(--card)] rounded-sm border border-[var(--line)]">↓</kbd> Navigasi</span>
        <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 bg-[var(--card)] rounded-sm border border-[var(--line)]">↵</kbd> Buka</span>
      </div>
      <span><kbd class="px-1.5 py-0.5 bg-[var(--card)] rounded-sm border border-[var(--line)]">ESC</kbd> Tutup</span>
    </div>
  </div>
</div>

<script define:vars={{ searchIndex, noResultsText: t('search.noResults') }}>
  function setupSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const closeBtn = document.getElementById('search-close-btn');
    const triggerDesktop = document.getElementById('search-trigger-btn');
    const triggerMobile = document.getElementById('search-trigger-mobile');

    if (!modal || !input || !resultsContainer) return;

    let activeIndex = -1;

    function openModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.value = '';
      renderResults(searchIndex);
      setTimeout(() => input.focus(), 50);
    }

    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      activeIndex = -1;
    }

    function renderResults(items) {
      if (!items.length) {
        resultsContainer.innerHTML = `<div class="p-6 text-center font-mono text-sm text-[var(--muted)]">${noResultsText}</div>`;
        activeIndex = -1;
        return;
      }

      resultsContainer.innerHTML = items
        .map(
          (item, idx) => `
          <a
            href="${item.url}"
            class="search-result-item flex items-start justify-between gap-3 p-3 rounded-lg hover:bg-[var(--paper-deep)] transition-colors group cursor-pointer ${idx === activeIndex ? 'bg-[var(--paper-deep)]' : ''}"
            data-index="${idx}"
          >
            <div class="space-y-1 flex-1">
              <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-[var(--ink)] group-hover:text-[var(--green)]">
                  ${item.title}
                </span>
                ${item.topics.length ? `<span class="font-mono text-[10px] px-2 py-0.5 rounded-full border border-[var(--line)] bg-[var(--card)] text-[var(--green)] font-medium">${item.topics.join(', ')}</span>` : ''}
              </div>
              <p class="text-xs text-[var(--ink-soft)] line-clamp-1">${item.description}</p>
            </div>
          </a>
        `
        )
        .join('');
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        renderResults(searchIndex);
        return;
      }
      const filtered = searchIndex.filter(
        (post) =>
          post.title.toLowerCase().includes(q) ||
          post.description.toLowerCase().includes(q) ||
          post.topics.some((t) => t.toLowerCase().includes(q))
      );
      renderResults(filtered);
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }

      if (!modal.classList.contains('hidden')) {
        const items = resultsContainer.querySelectorAll('.search-result-item');
        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          updateActiveSelection(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          updateActiveSelection(items);
        } else if (e.key === 'Enter') {
          if (activeIndex >= 0 && items[activeIndex]) {
            e.preventDefault();
            items[activeIndex].click();
          }
        }
      }
    });

    function updateActiveSelection(items) {
      items.forEach((el, idx) => {
        if (idx === activeIndex) {
          el.classList.add('bg-[var(--paper-deep)]');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-[var(--paper-deep)]');
        }
      });
    }

    triggerDesktop?.addEventListener('click', openModal);
    triggerMobile?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
