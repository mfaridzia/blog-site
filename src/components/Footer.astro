---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const rssUrl = lang === 'id' ? '/id/rss.xml' : '/en/rss.xml';
---

<footer class="w-full border-t border-[var(--line)] mt-auto py-10 text-xs text-[var(--muted)]">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex flex-col sm:flex-row items-center gap-2 text-center sm:text-left">
      <p>© {currentYear} {siteConfig.author}.</p>
      <span class="hidden sm:inline">•</span>
      <p>{t('footer.tagline')}</p>
    </div>

    <div class="flex items-center gap-5">
      <a
        href={rssUrl}
        target="_blank"
        class="hover:text-[var(--copper)] transition-colors flex items-center gap-1"
      >
        <Icon name="rss" class="w-3.5 h-3.5" />
        <span>RSS</span>
      </a>

      <button
        type="button"
        id="back-to-top"
        class="hover:text-[var(--copper)] transition-colors flex items-center gap-1 cursor-pointer focus:outline-hidden"
        aria-label={t('footer.backToTop')}
      >
        <Icon name="arrow-up" class="w-3.5 h-3.5" />
        <span>{t('footer.backToTop')}</span>
      </button>
    </div>
  </div>
</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  setupBackToTop();
  document.addEventListener('astro:after-swap', setupBackToTop);
</script>
