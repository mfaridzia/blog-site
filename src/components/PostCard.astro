---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const slug = post.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '');
const postUrl = formatUrl(`/posts/${slug}`, lang);
const topicsString = post.data.topics.join(' / ');
const topicsData = post.data.topics.map(t => t.toLowerCase()).join(',');
---

<article
  class="post-item group border-b border-[var(--line)] py-6 sm:py-8 last:border-b-0"
  data-topics={topicsData}
>
  <a
    href={postUrl}
    class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(160px,240px)] items-center gap-6"
  >
    <!-- Post Text Content -->
    <div class="space-y-2">
      <div class="flex items-center gap-2 text-xs text-[var(--muted)]">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
        {topicsString && (
          <>
            <span>•</span>
            <span class="font-medium text-[var(--moss)]">
              {topicsString}
            </span>
          </>
        )}
      </div>

      <!-- Title (Serif Display) -->
      <h3 class="font-display text-2xl sm:text-3xl font-medium tracking-tight text-[var(--ink)] group-hover:text-[var(--copper)] transition-colors leading-snug">
        {post.data.title}
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-[var(--ink-soft)] leading-relaxed line-clamp-2 max-w-2xl">
        {post.data.description}
      </p>
    </div>

    <!-- Thumbnail Image (Aspect 4/3 matching sdust) -->
    {post.data.cover && (
      <div class="w-full h-40 md:h-32 shrink-0 rounded-lg overflow-hidden border border-[var(--line)] bg-[var(--paper-deep)]">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </a>
</article>
