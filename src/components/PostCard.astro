---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const slug = post.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '');
const postUrl = formatUrl(`/posts/${slug}`, lang);
const topicsString = post.data.topics.join(' / ');
const topicsData = post.data.topics.map(t => t.toLowerCase()).join(',');
---

<article
  class="post-item group border-b border-[var(--line)] py-6 sm:py-8 last:border-b-0 min-w-0"
  data-topics={topicsData}
>
  <a
    href={postUrl}
    class="flex flex-col-reverse sm:grid sm:grid-cols-[minmax(0,1fr)_minmax(140px,220px)] items-start sm:items-center gap-4 sm:gap-6 min-w-0"
  >
    <!-- Post Text Content -->
    <div class="space-y-1.5 sm:space-y-2 min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--muted)]">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
        {topicsString && (
          <>
            <span>•</span>
            <span class="font-medium text-[var(--green)]">
              {topicsString}
            </span>
          </>
        )}
      </div>

      <!-- Title -->
      <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[var(--ink)] group-hover:text-[var(--green)] transition-colors leading-snug break-words">
        {post.data.title}
      </h3>

      <!-- Excerpt -->
      <p class="text-xs sm:text-sm text-[var(--ink-soft)] leading-relaxed line-clamp-2 max-w-2xl break-words">
        {post.data.description}
      </p>
    </div>

    <!-- Thumbnail Image -->
    {post.data.cover && (
      <div class="w-full sm:w-auto h-44 sm:h-32 shrink-0 rounded-lg overflow-hidden border border-[var(--line)] bg-[var(--paper-deep)]">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </a>
</article>
