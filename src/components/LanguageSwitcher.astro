---
import type { Lang } from '../i18n/utils';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;

let idPath = '/';
let enPath = '/en';

if (currentLang === 'id') {
  idPath = currentPath;
  enPath = currentPath === '/' ? '/en' : `/en${currentPath}`;
} else {
  enPath = currentPath;
  const stripped = currentPath.replace(/^\/en/, '') || '/';
  idPath = stripped;
}
---

<div class="inline-flex items-center rounded-full border border-[var(--line)] bg-[var(--card)] p-0.5 text-xs font-mono font-medium text-[var(--ink-soft)]">
  <a
    href={idPath}
    class:list={[
      'px-2.5 py-1 rounded-full transition-all',
      currentLang === 'id'
        ? 'bg-[var(--green)] text-white shadow-xs font-semibold'
        : 'hover:text-[var(--green)]'
    ]}
    aria-label="Bahasa Indonesia"
  >
    ID
  </a>
  <a
    href={enPath}
    class:list={[
      'px-2.5 py-1 rounded-full transition-all',
      currentLang === 'en'
        ? 'bg-[var(--green)] text-white shadow-xs font-semibold'
        : 'hover:text-[var(--green)]'
    ]}
    aria-label="English"
  >
    EN
  </a>
</div>
