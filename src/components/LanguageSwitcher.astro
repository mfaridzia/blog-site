---
import type { Lang } from '../i18n/utils';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;

// Calculate target paths
const stripped = currentPath.replace(/^\/(en|id)(\/|$)/, '/');
const normalized = stripped.startsWith('/') ? stripped : `/${stripped}`;

const enPath = `/en${normalized === '/' ? '' : normalized}`;
const idPath = `/id${normalized === '/' ? '' : normalized}`;
---

<div class="inline-flex items-center rounded-full border border-[var(--line)] bg-[var(--card)] p-0.5 text-xs font-mono font-medium text-[var(--ink-soft)]">
  <a
    href={enPath}
    class:list={[
      'px-2.5 py-1 rounded-full transition-all',
      currentLang === 'en'
        ? 'bg-[var(--green)] text-white shadow-xs font-semibold'
        : 'hover:text-[var(--green)]'
    ]}
    aria-label="English"
  >
    EN
  </a>
  <a
    href={idPath}
    class:list={[
      'px-2.5 py-1 rounded-full transition-all',
      currentLang === 'id'
        ? 'bg-[var(--green)] text-white shadow-xs font-semibold'
        : 'hover:text-[var(--green)]'
    ]}
    aria-label="Bahasa Indonesia"
  >
    ID
  </a>
</div>
