---
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { useTranslations, formatUrl } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = siteConfig.title[lang];
const archiveUrl = formatUrl('/#archive', lang);
const aboutUrl = formatUrl('/about', lang);
const rssUrl = lang === 'id' ? '/id/rss.xml' : '/en/rss.xml';
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--line)] bg-[var(--paper)]/95 backdrop-blur-md transition-colors">
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 md:px-8 h-16 sm:h-18 flex items-center justify-between gap-2">
    <!-- Brand -->
    <a href={formatUrl('/', lang)} class="flex items-center gap-2.5 sm:gap-3 group focus-visible:outline-2 focus-visible:outline-[var(--green)] rounded-lg min-w-0">
      <img
        src={siteConfig.avatar}
        alt={siteConfig.author}
        class="w-8 h-8 sm:w-10 sm:h-10 rounded-full object-cover border border-[var(--line)] group-hover:scale-105 transition-transform shrink-0"
        width="40"
        height="40"
      />
      <span class="font-semibold text-[var(--ink)] tracking-tight text-sm sm:text-base md:text-lg group-hover:text-[var(--green)] transition-colors truncate max-w-[140px] xs:max-w-[200px] sm:max-w-none">
        {title}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[var(--ink-soft)] shrink-0">
      <a href={archiveUrl} class="hover:text-[var(--green)] transition-colors">
        {t('nav.archive')}
      </a>
      <a href={aboutUrl} class="hover:text-[var(--green)] transition-colors">
        {t('nav.about')}
      </a>
      <a href={rssUrl} target="_blank" class="hover:text-[var(--green)] transition-colors flex items-center gap-1.5" title="RSS Feed">
        <Icon name="rss" class="w-3.5 h-3.5" />
        <span>{t('nav.rss')}</span>
      </a>

      <!-- Search Trigger -->
      <button
        type="button"
        id="search-trigger-btn"
        class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--line)] text-xs text-[var(--muted)] hover:text-[var(--ink)] hover:border-[var(--green)] bg-[var(--card)] transition-colors cursor-pointer"
        aria-label={t('search.button')}
      >
        <Icon name="search" class="w-3.5 h-3.5" />
        <span>{t('search.placeholder')}</span>
        <kbd class="ml-1 px-1.5 py-0.5 text-[10px] font-mono bg-[var(--paper-deep)] border border-[var(--line)] rounded-sm">⌘K</kbd>
      </button>

      <div class="h-4 w-px bg-[var(--line)]" />

      <!-- Language & Theme -->
      <LanguageSwitcher currentLang={lang} />
      <ThemeToggle />
    </nav>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2 md:hidden shrink-0">
      <button
        type="button"
        id="search-trigger-mobile"
        class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--ink-soft)] hover:text-[var(--green)] border border-[var(--line)] bg-[var(--card)] cursor-pointer"
        aria-label={t('search.button')}
      >
        <Icon name="search" class="w-3.5 h-3.5" />
      </button>
      <LanguageSwitcher currentLang={lang} />
      <ThemeToggle />
      <button
        type="button"
        id="mobile-menu-btn"
        class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--ink-soft)] hover:text-[var(--green)] border border-[var(--line)] bg-[var(--card)] cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span id="mobile-menu-icon-open">
          <Icon name="menu" class="w-3.5 h-3.5" />
        </span>
        <span id="mobile-menu-icon-close" class="hidden">
          <Icon name="close" class="w-3.5 h-3.5" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[var(--line)] bg-[var(--paper)] px-4 sm:px-6 py-4 space-y-3 text-sm font-medium">
    <a href={archiveUrl} class="block py-2 text-[var(--ink-soft)] hover:text-[var(--green)] border-b border-[var(--line)]/40">
      {t('nav.archive')}
    </a>
    <a href={aboutUrl} class="block py-2 text-[var(--ink-soft)] hover:text-[var(--green)] border-b border-[var(--line)]/40">
      {t('nav.about')}
    </a>
    <a href={rssUrl} target="_blank" class="flex items-center gap-2 py-2 text-[var(--ink-soft)] hover:text-[var(--green)]">
      <Icon name="rss" class="w-4 h-4" />
      <span>{t('nav.rss')} Feed</span>
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-menu-icon-open');
    const iconClose = document.getElementById('mobile-menu-icon-close');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
