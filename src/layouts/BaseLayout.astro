---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import CodeCopyButton from '../components/CodeCopyButton.astro';
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Lang;
  article?: boolean;
}

const {
  lang = 'id',
  title,
  description,
  image = siteConfig.avatar,
  article = false
} = Astro.props;

const pageTitle = title
  ? `${title} | ${siteConfig.title[lang]}`
  : `${siteConfig.title[lang]} - ${siteConfig.eyebrow[lang]}`;
const pageDescription = description || siteConfig.description[lang];
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.siteUrl);
const ogImage = new URL(image, Astro.site || siteConfig.siteUrl);
---

<!doctype html>
<html lang={lang === 'id' ? 'id-ID' : 'en-US'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/avatar.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={siteConfig.author} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.title[lang]} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- RSS Feed link -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.title[lang]}
      href={lang === 'id' ? '/rss.xml' : '/en/rss.xml'}
    />

    <!-- Anti-flicker Dark Mode Script -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (theme === 'dark' || (!theme && systemDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[var(--moss-light)] selection:bg-opacity-20">
    <Header lang={lang} />
    
    <main id="main-content" class="flex-1 w-full max-w-[1120px] mx-auto px-4 sm:px-6 md:px-8 py-8 md:py-12">
      <slot />
    </main>

    <Footer lang={lang} />
    <SearchModal lang={lang} />
    <CodeCopyButton lang={lang} />
  </body>
</html>
