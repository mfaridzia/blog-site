---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl, useTranslations } from '../i18n/utils';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, headings, prevPost, nextPost, lang } = Astro.props;
const t = useTranslations(lang);
const archiveUrl = formatUrl('/#archive', lang);
const aboutUrl = formatUrl('/about', lang);

const prevSlug = prevPost ? prevPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '') : null;
const nextSlug = nextPost ? nextPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '') : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover || siteConfig.avatar}
  lang={lang}
  article={true}
>
  <article class="pt-4 pb-16 space-y-8">
    <!-- Back to Archive -->
    <div>
      <a
        href={archiveUrl}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors"
      >
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        <span>{t('post.back')}</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {post.data.description}
      </p>

      <!-- Metadata -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 pt-2 text-xs text-slate-500 dark:text-slate-400 border-b border-slate-200/80 dark:border-slate-800/80 pb-6">
        <span>
          {t('post.by')}{' '}
          <a href={aboutUrl} class="font-medium text-slate-800 dark:text-slate-200 hover:underline">
            {siteConfig.author}
          </a>
        </span>
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
        {post.data.readingTime && (
          <>
            <span>•</span>
            <span>{post.data.readingTime}</span>
          </>
        )}

        <!-- Topic Tags -->
        {post.data.topics.length > 0 && (
          <div class="flex items-center gap-1.5 ml-auto">
            {post.data.topics.map((topic) => (
              <a
                href={`${formatUrl('/', lang)}?topic=${encodeURIComponent(topic.toLowerCase())}#archive`}
                class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 font-medium transition-colors"
              >
                {topic}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Cover Image -->
    {post.data.cover && (
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-xs max-h-[460px] bg-slate-100 dark:bg-slate-800">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <!-- Content & Sticky Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-4">
      <!-- Article Prose -->
      <div class="lg:col-span-8 prose prose-slate dark:prose-invert max-w-none">
        <slot />
      </div>

      <!-- Table of Contents Sidebar -->
      <aside class="hidden lg:block lg:col-span-4 pl-4">
        <TableOfContents headings={headings} lang={lang} />
      </aside>
    </div>

    <!-- Pager (Previous / Next Post) -->
    {(prevPost || nextPost) && (
      <nav
        class="border-t border-slate-200/80 dark:border-slate-800/80 pt-8 mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4"
        aria-label="Post pagination"
      >
        {prevPost ? (
          <a
            href={formatUrl(`/posts/${prevSlug}`, lang)}
            class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white/40 dark:bg-slate-900/40 transition-colors"
          >
            <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex items-center gap-1">
              <Icon name="arrow-left" class="w-3 h-3 group-hover:-translate-x-0.5 transition-transform" />
              {t('post.older')}
            </span>
            <p class="mt-1 text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1">
              {prevPost.data.title}
            </p>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={formatUrl(`/posts/${nextSlug}`, lang)}
            class="group p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white/40 dark:bg-slate-900/40 text-right transition-colors"
          >
            <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex items-center justify-end gap-1">
              {t('post.newer')}
              <Icon name="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" />
            </span>
            <p class="mt-1 text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1">
              {nextPost.data.title}
            </p>
          </a>
        ) : <div />}
      </nav>
    )}
  </article>
</BaseLayout>
