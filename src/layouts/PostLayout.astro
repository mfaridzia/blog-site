---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site.config';
import type { Lang } from '../i18n/utils';
import { formatDate, formatUrl, useTranslations } from '../i18n/utils';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, headings, prevPost, nextPost, lang } = Astro.props;
const t = useTranslations(lang);
const archiveUrl = formatUrl('/#archive', lang);
const aboutUrl = formatUrl('/about', lang);

const prevSlug = prevPost ? prevPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '') : null;
const nextSlug = nextPost ? nextPost.id.replace(/^(id|en)\//, '').replace(/\.(md|mdx)$/, '') : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover || siteConfig.avatar}
  lang={lang}
  article={true}
>
  <article class="pt-2 pb-16 space-y-10">
    <!-- Back to Archive -->
    <div>
      <a
        href={archiveUrl}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--muted)] hover:text-[var(--copper)] transition-colors"
      >
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        <span>{t('post.back')}</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4">
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium tracking-tight text-[var(--ink)] leading-[1.05]">
        {post.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-[var(--ink-soft)] leading-relaxed max-w-3xl">
        {post.data.description}
      </p>

      <!-- Metadata Row -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 pt-2 text-xs text-[var(--muted)] border-b border-[var(--line)] pb-6">
        <span>
          {t('post.by')}{' '}
          <a href={aboutUrl} class="font-medium text-[var(--ink)] hover:text-[var(--copper)] underline underline-offset-4 decoration-[var(--copper)]">
            {siteConfig.author}
          </a>
        </span>
        <span>•</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
        {post.data.readingTime && (
          <>
            <span>•</span>
            <span class="tabular-nums">{post.data.readingTime}</span>
          </>
        )}

        <!-- Topic Pill Badges -->
        {post.data.topics.length > 0 && (
          <div class="flex items-center gap-2 ml-auto">
            {post.data.topics.map((topic) => (
              <a
                href={`${formatUrl('/', lang)}?topic=${encodeURIComponent(topic.toLowerCase())}#archive`}
                class="px-3 py-1 rounded-full border border-[var(--line)] text-[var(--moss)] hover:text-[var(--copper)] hover:border-[var(--copper)] font-medium transition-colors"
              >
                {topic}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- High-res Cover Image Banner -->
    {post.data.cover && (
      <div class="rounded-xl overflow-hidden border border-[var(--line)] shadow-xs max-h-[500px] bg-[var(--paper-deep)]">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt || post.data.title}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <!-- 2-Column Content Grid: Main Prose + Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_220px] gap-10 lg:gap-14 pt-2 items-start">
      <!-- Article Prose -->
      <div class="prose max-w-none">
        <slot />
      </div>

      <!-- Sticky Table of Contents Sidebar -->
      <aside class="hidden lg:block sticky top-28 self-start pl-4 border-l border-[var(--line)]">
        <TableOfContents headings={headings} lang={lang} />
      </aside>
    </div>

    <!-- Article Navigation Pager (Older / Newer) -->
    {(prevPost || nextPost) && (
      <nav
        class="border-t border-[var(--line)] pt-10 mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4"
        aria-label="Post pagination"
      >
        {prevPost ? (
          <a
            href={formatUrl(`/posts/${prevSlug}`, lang)}
            class="group p-5 rounded-xl border border-[var(--line)] hover:border-[var(--copper)] bg-[var(--paper-deep)]/40 transition-colors"
          >
            <span class="text-[11px] font-bold text-[var(--muted)] uppercase tracking-wider flex items-center gap-1.5 group-hover:text-[var(--copper)]">
              <Icon name="arrow-left" class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" />
              {t('post.older')}
            </span>
            <p class="mt-2 font-display text-lg font-medium text-[var(--ink)] group-hover:text-[var(--copper)] line-clamp-1">
              {prevPost.data.title}
            </p>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={formatUrl(`/posts/${nextSlug}`, lang)}
            class="group p-5 rounded-xl border border-[var(--line)] hover:border-[var(--copper)] bg-[var(--paper-deep)]/40 text-right transition-colors"
          >
            <span class="text-[11px] font-bold text-[var(--muted)] uppercase tracking-wider flex items-center justify-end gap-1.5 group-hover:text-[var(--copper)]">
              {t('post.newer')}
              <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
            </span>
            <p class="mt-2 font-display text-lg font-medium text-[var(--ink)] group-hover:text-[var(--copper)] line-clamp-1">
              {nextPost.data.title}
            </p>
          </a>
        ) : <div />}
      </nav>
    )}
  </article>
</BaseLayout>
